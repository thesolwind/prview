{
  "name": "@thesolwind/prview",
  "version": "0.1.1",
  "description": "GitHub-style diff reviewer for the terminal, with AI summaries, review notes from Claude Code, viewed-state and line notes",
  "keywords": [
    "diff",
    "git",
    "code-review",
    "review",
    "pull-request",
    "tui",
    "terminal",
    "cli",
    "ink",
    "claude-code"
  ],
  "license": "MIT",
  "author": "thesolwind",
  "homepage": "https://github.com/thesolwind/prview#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thesolwind/prview.git"
  },
  "bugs": {
    "url": "https://github.com/thesolwind/prview/issues"
  },
  "type": "module",
  "bin": {
    "prview": "dist/cli.js"
  },
  "files": [
    "dist/cli.js",
    ".claude/skills/"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "start": "npm run build && node dist/cli.js",
    "test": "node scripts/test.mjs",
    "clean": "git clean -fdX",
    "preview": "node scripts/build.mjs --preview && node dist/preview.js",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "ink": "^5.1.0",
    "react": "^18.3.1",
    "shiki": "^1.24.2",
    "string-width": "^7.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
